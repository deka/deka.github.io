{
  "name": "deka-landing",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/jsonresume-theme-dev-ats",
    "packages/jsonresume-theme-caffeine"
  ],
  "scripts": {
    "dev": "next dev",
    "resume": "resumed render ./app/assets/resume.json --theme jsonresume-theme-caffeine --output ./public/resume.html && node scripts/improve.js",
    "resume-ats": "resumed render ./app/assets/resume.json --theme jsonresume-theme-dev-ats --output ./public/resume-ats.html",
    "build": "npm run resume && npm run resume-ats && next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "build:static": "next build"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "10.2.1",
    "eslint-config-next": "16.2.4",
    "jsonresume-theme-caffeine": "*",
    "jsonresume-theme-dev-ats": "*",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "resumed": "^6.1.0"
  }
}
